# Bu dosyayı .env adıyla kopyala. Sadece geliştirme modunda (npm run dev) okunur.

# Hangi yapay zeka kullanılsın:
#   cli  = Claude aboneliğin, bilgisayarındaki Claude Code üzerinden (varsayılan)
#   api  = kendi Anthropic API anahtarın
#   mock = sahte yapay zeka, Claude'u hiç çağırmaz (test için)
CS_AI_PROVIDER=cli

# İsteğe bağlı model.
#   cli: Claude Code'un --model değeri (örn. opus, sonnet). Boşsa Claude Code'un varsayılanı.
#   api: tam model kimliği. Boşsa claude-opus-5.
# CS_AI_MODEL=

# Sadece CS_AI_PROVIDER=api iken okunur. Abonelik yoluna (cli) asla verilmez.
# ANTHROPIC_API_KEY=

# claude komutu bulunamazsa tam yolunu yaz (örn. /Users/senin-adin/.local/bin/claude).
# CS_CLAUDE_PATH=
