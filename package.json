{
  "name": "cause-state",
  "productName": "Cause & State",
  "version": "0.1.0",
  "private": true,
  "description": "Cause & State — kararlarının kelebek etkisiyle döndüğü, yapay zeka destekli modern dünya strateji oyunu.",
  "author": "Bogac Sasmaz",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "kanit": "tsx --tsconfig tsconfig.node.json scripts/faz05-kanit.mts",
    "playtest": "tsx --tsconfig tsconfig.node.json scripts/playtest.mts",
    "playthrough": "node scripts/playthrough.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
